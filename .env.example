# DeepSeek API Configuration
DEEPSEEK_SCORING_API_KEY=your_deepseek_scoring_api_key_here
DEEPSEEK_CHAT_API_KEY=your_deepseek_chat_api_key_here
DEEPSEEK_BASE_URL=https://llmapi.paratera.com


# Application Settings
DEBUG=false
LOG_LEVEL=INFO

# Web Interface Settings
STREAMLIT_PORT=8501
STREAMLIT_HOST=0.0.0.0

# WebSocket Settings
WEBSOCKET_PORT=8765
WEBSOCKET_HOST=0.0.0.0

# Database Settings (optional until database-backed features are enabled)
DATABASE_URL=postgresql+psycopg://labagent:change_me@localhost:5432/labagent
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=5
DATABASE_POOL_TIMEOUT=30
DATABASE_ECHO=false

# Optional. Used only for PostgreSQL integration tests.
TEST_DATABASE_URL=

# Email OTP authentication (secrets are required only when auth is used)
LABAGENT_ALLOWED_EMAIL_DOMAINS=mails.tsinghua.edu.cn,mail.tsinghua.edu.cn
AUTH_OTP_HMAC_SECRET=
AUTH_OTP_TTL_SECONDS=300
AUTH_OTP_MAX_ATTEMPTS=5
AUTH_OTP_RESEND_COOLDOWN_SECONDS=60
AUTH_OTP_MAX_REQUESTS_PER_WINDOW=5
AUTH_OTP_REQUEST_WINDOW_SECONDS=600
AUTH_SESSION_HMAC_SECRET=
AUTH_SESSION_TTL_DAYS=30
AUTH_COOKIE_NAME=labagent_session
AUTH_COOKIE_SECURE=true
LABAGENT_STREAMLIT_PUBLIC_URL=http://localhost:8501
LABAGENT_AUTH_GATEWAY_PUBLIC_URL=http://localhost:8000

# Optional SMTP transport for manual OTP delivery (never commit real credentials)
SMTP_HOST=mails.tsinghua.edu.cn
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_FROM_NAME=LabAgent
SMTP_USE_SSL=true
SMTP_TIMEOUT_SECONDS=20

# External API Settings
ARXIV_BASE_URL=http://export.arxiv.org/api/query

# Rate Limiting
API_RATE_LIMIT=60
SCRAPING_DELAY=1.0

# Timezone Settings
DEFAULT_TIMEZONE=Asia/Shanghai
LABAGENT_PROJECT_ROOT=/data/zmr/projects/labAgent_Server
