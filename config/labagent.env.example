# Copy to /data/zmr/projects/labagent_runtime/labagent.env on the server.
# Keep the real file outside the deployment directory and set mode 600.

# Runtime
LABAGENT_PROJECT_ROOT=/data/zmr/projects/labAgent_Server
DEFAULT_TIMEZONE=Asia/Shanghai

# Database
DATABASE_URL=postgresql+psycopg://labagent:<PASSWORD>@127.0.0.1:55432/labagent

# Allowed email domains
LABAGENT_ALLOWED_EMAIL_DOMAINS=mails.tsinghua.edu.cn,mail.tsinghua.edu.cn

# OTP
AUTH_OTP_HMAC_SECRET=<GENERATE_RANDOM_SECRET>
AUTH_OTP_TTL_SECONDS=300
AUTH_OTP_MAX_ATTEMPTS=5
AUTH_OTP_RESEND_COOLDOWN_SECONDS=60
AUTH_OTP_MAX_REQUESTS_PER_WINDOW=5
AUTH_OTP_REQUEST_WINDOW_SECONDS=600

# Session
AUTH_SESSION_HMAC_SECRET=<GENERATE_RANDOM_SECRET>
AUTH_SESSION_TTL_DAYS=30

# Cookie
AUTH_COOKIE_NAME=labagent_session
AUTH_COOKIE_SECURE=false

# Public URLs
LABAGENT_AUTH_GATEWAY_PUBLIC_URL=http://SERVER_IP:8000
LABAGENT_STREAMLIT_PUBLIC_URL=http://SERVER_IP:8501

# SMTP
SMTP_HOST=mails.tsinghua.edu.cn
SMTP_PORT=465
SMTP_USERNAME=<SCHOOL_EMAIL>
SMTP_PASSWORD=<APP_PASSWORD>
SMTP_FROM=<SCHOOL_EMAIL>
SMTP_FROM_NAME=LabAgent
SMTP_USE_SSL=true
SMTP_TIMEOUT_SECONDS=20

# LLM
DEEPSEEK_CHAT_API_KEY=<API_KEY>
DEEPSEEK_SCORING_API_KEY=<API_KEY>
DEEPSEEK_BASE_URL=<API_BASE_URL>

# Streamlit
STREAMLIT_HOST=0.0.0.0
STREAMLIT_PORT=8501
